PORT=8000
NODE_ENV=development

# MongoDB single-node replica set connection
MONGO_URI="mongodb://localhost:27017/newtonite_ops?replicaSet=rs0&directConnection=true"

# Session configuration (Required - will fail fast if missing)
SESSION_SECRET="your-secure-session-secret-here-min-32-chars"
SESSION_EXPIRES_IN="1d"

# Frontend configuration
FRONTEND_ORIGIN="http://localhost:5173"